# ─── Database & Auth ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://core:core@postgres:5432/core?sslmode=disable
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-chars-long

# ─── Redis & Queue ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Object Storage (AWS S3, MinIO, or Cloudflare R2) ──────────────────────
# Internal S3 endpoint used by backend API and worker containers:
S3_ENDPOINT=http://minio:9000
# Public S3 endpoint accessible by the user's web browser for presigned uploads:
# (Set to http://YOUR_SERVER_IP:9000 or https://s3.yourdomain.com when using MinIO on a VPS)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=core
S3_SECRET_KEY=coreminio
S3_BUCKET=chie-documents

# ─── AI Providers (Embeddings, RAG & Vision) ────────────────────────────────
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=open-mistral-7b

# ─── Networking & Web Origins ───────────────────────────────────────────────
# Allowed origin for web browser requests to API:
CORS_ORIGIN=http://localhost:3000
# API URL baked into Next.js frontend bundles:
NEXT_PUBLIC_API_URL=http://localhost:4000
