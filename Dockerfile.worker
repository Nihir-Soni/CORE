# ==============================================================================
# CORE Background Document Processing Worker Dockerfile
# ==============================================================================
FROM node:22-bookworm-slim AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@11.22.0 --activate

# Install OpenSSL for Prisma engine and Tesseract OCR for document character extraction
RUN apt-get update -y && \
    apt-get install -y openssl ca-certificates curl tesseract-ocr tesseract-ocr-eng && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy root workspace configurations
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.base.json ./

# Copy package manifests
COPY packages/shared/package.json ./packages/shared/
COPY packages/database/package.json ./packages/database/
COPY packages/storage/package.json ./packages/storage/
COPY packages/ai/package.json ./packages/ai/
COPY packages/chunking/package.json ./packages/chunking/
COPY packages/extraction/package.json ./packages/extraction/
COPY packages/indexing/package.json ./packages/indexing/
COPY packages/jobs/package.json ./packages/jobs/
COPY workers/document-processing/package.json ./workers/document-processing/

# Install dependencies
RUN pnpm install --frozen-lockfile --fetch-timeout=300000 --fetch-retries=5

# Copy source code
COPY packages/ ./packages/
COPY workers/document-processing/ ./workers/document-processing/

# Generate Prisma Client & Build TypeScript modules
RUN pnpm --filter @core/database generate
RUN pnpm --filter @core/shared build
RUN pnpm --filter @core/database build
RUN pnpm --filter @core/storage build
RUN pnpm --filter @core/extraction build
RUN pnpm --filter @core/chunking build
RUN pnpm --filter @core/ai build
RUN pnpm --filter @core/jobs build
RUN pnpm --filter @core/indexing build
RUN pnpm --filter document-processing-worker build

ENV NODE_ENV=production

CMD ["pnpm", "--filter", "document-processing-worker", "start"]
